{
	"name": "ghloc-extension",
	"type": "module",
	"repository": "https://github.com/pajecawav/ghloc-extension",
	"author": "pajecawav",
	"license": "MIT",
	"scripts": {
		"start:chromium": "web-ext run -s dist -t chromium",
		"start:firefox": "web-ext run -s dist -t firefox-desktop",
		"build": "rsbuild build && web-ext build -s dist --overwrite-dest",
		"dev": "rsbuild build --watch",
		"lint": "tsc --noEmit && web-ext lint -s dist"
	},
	"devDependencies": {
		"@pajecawav/prettier-config": "^1.0.2",
		"@rsbuild/core": "^2.2.13",
		"@rsbuild/plugin-babel": "^2.1.0",
		"@rsbuild/plugin-solid": "^1.2.2",
		"@types/chrome": "^0.3.5",
		"prettier": "^3.9.10",
		"solid-js": "^1.9.17",
		"typescript": "^7.0.2",
		"web-ext": "^10.8.0"
	},
	"packageManager": "pnpm@12.14.0"
}
